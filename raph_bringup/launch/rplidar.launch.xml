<launch version="0.1.1">

  <arg name="tf_frame_prefix"
    default=""
    description="The prefix added to each published TF frame id" />

  <lifecycle_node namespace="rplidar"
    name="rplidar_node"
    pkg="rplidar_driver"
    exec="rplidar_node"
    autostart="true">
    <param name="frame_id" value="$(var tf_frame_prefix)laser_frame" />
  </lifecycle_node>

  <node namespace="rplidar"
    pkg="laser_filters"
    exec="scan_to_scan_filter_chain">
    <param name="filter1.params.box_frame" value="$(var tf_frame_prefix)base_link" />
    <remap from="scan_in" to="scan" />
  </node>

</launch>
